@using dotnet_store.Models
@{
    var recentOrders = ViewBag.RecentOrders as List<Order> ?? new List<Order>();
}
<div class="row">
    <div class="col">
        <div class="card shadow">
            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Son Siparişler</h5>
                <a asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-primary">
                    Tümünü Gör
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>#</th>
                                <th>Müşteri</th>
                                <th>Toplam</th>
                                <th>Tarih</th>
                                <th style="width:60px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!recentOrders.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">Henüz sipariş yok.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var order in recentOrders)
                                {
                                    <tr>
                                        <td>#@order.Id</td>
                                        <td>
                                            <div class="fw-semibold">@order.FullName</div>
                                            <small class="text-muted">@order.Username</small>
                                        </td>
                                        <td class="fw-semibold text-primary">@order.TotalPrice.ToString("N0") ₺</td>
                                        <td>@order.OrderTime.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                                               class="btn btn-sm btn-primary">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
