<div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col">
                        <div class="fw-bold text-primary text-uppercase mb-1">Toplam Satış</div>
                        <div class="h5 mb-0 fw-bold">@(((double)ViewBag.TotalSales).ToString("N0")) ₺</div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-dollar-sign fa-2x text-secondary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col">
                        <div class="fw-bold text-success text-uppercase mb-1">Sipariş</div>
                        <div class="h5 mb-0 fw-bold">@ViewBag.TotalOrders</div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-truck fa-2x text-secondary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col">
                        <div class="fw-bold text-warning text-uppercase mb-1">Ürün</div>
                        <div class="h5 mb-0 fw-bold">@ViewBag.TotalProducts</div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-box fa-2x text-secondary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col">
                        <div class="fw-bold text-info text-uppercase mb-1">Ortalama Sipariş</div>
                        <div class="h5 mb-0 fw-bold">
                            @{
                                double avg = (int)ViewBag.TotalOrders > 0
                                    ? (double)ViewBag.TotalSales / (int)ViewBag.TotalOrders
                                    : 0;
                            }
                            @avg.ToString("N0") ₺
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-chart-line fa-2x text-secondary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
