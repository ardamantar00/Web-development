@model Cart

@section Bar {
    <section class="bg-primary p-3">
        <div class="container">
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="#">Ana Sayfa</a>
                    </li>
                    <li class="breadcrumb-item">
                        Alışveriş Sepeti
                    </li>
                </ol>
            </nav>
        </div>
    </section>
}
<section class="mt-3">
    <div class="container">
        @if (Model.CartItems.Count == 0)
        {
            <div class="alert alert-warning">
                Sepette Ürün Bulunmuyor
            </div>
        }
        else
        {
             <div class="row">
            <div class="col-lg-7">
                <ul class="list-group">
                    @foreach (var item in Model.CartItems)
                    {
                        <li class="py-3 mb-2 border-top list-group-item">
                            <div class="row align-items-center">
                                <div class="col-5 d-flex align-items-center">
                                    <div>
                                        <img src="~/img/@item.Product.Image" alt="" style="width: 100px" />
                                        <div class="ms-3">
                                            <a href="" class="text-decoration-none">
                                                <h6 class="mb-0">@item.Product.ProductName</h6>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <input type="number" value="@item.Amount" class="form-control" min = 1>
                                </div>
                                <div class="col-2 text-center">
                                    <span class="fw-bold">@item.Product.Price ₺</span>
                                </div>
                                <div class="col-1">
                                    <form action="/Cart/RemoveItem" method="post">
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                         <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="col-lg-5">
                <div class="my-3 card">
                    <div class="p-3 card-body">
                        <h2 class="h5 mb-4">Sipariş Özeti</h2>
                        <div class="card mb-2">
                            <div class="list-group list-group-flush">
                                <div class="d-flex justify-content-center align-items-center list-group-item">
                                    <div class="me-auto">
                                        <div>Sipariş Toplamı</div>
                                    </div>
                                    <span>@Model.GetSubtotal() ₺</span>
                                </div>
                                <div class="d-flex justify-content-center align-items-center list-group-item">
                                    <div class="me-auto">
                                        <div>Kargo Ücreti</div>
                                    </div>
                                    <span>Ücretsiz</span>
                                </div>
                                <div class="d-flex justify-content-center align-items-center list-group-item">
                                    <div class="me-auto">
                                        <div>Vergiler(%20)</div>
                                    </div>
                                    <span>@(Model.GetSubtotal() * 0.2) ₺</span>
                                </div>
                                <div class="d-flex justify-content-center align-items-center list-group-item">
                                    <div class="me-auto">
                                        <div>Toplam</div>
                                    </div>
                                    <span>@Model.Sum() ₺</span>
                                </div>
                            </div>
                        </div>
                        <div class="d-grid">
                            <a href="#" class="btn btn-primary btn-lg">
                                Siparişi Tamamla
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }
       
    </div>
</section>