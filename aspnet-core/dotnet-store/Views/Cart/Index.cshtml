@model Cart

@section Bar {
    <section class="bg-primary p-3">
        <div class="container">
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="#">Ana Sayfa</a>
                    </li>
                    <li class="breadcrumb-item">
                        Alışveriş Sepeti
                    </li>
                </ol>
            </nav>
        </div>
    </section>
}
<section class="mt-3">
    <div class="container">
        @if (Model.CartItems.Count == 0)
        {
            <div class="alert alert-warning">
                Sepette Ürün Bulunmuyor
            </div>
        }
        else
        {
             <div class="row">
            <div class="col-lg-7">
                <ul class="list-group">
                    @foreach (var item in Model.CartItems)
                    {
                        <li class="py-3 mb-2 border-top list-group-item">
                            <div class="row align-items-center">
                                <div class="col-5 d-flex align-items-center">
                                    <div>
                                        <img src="~/img/@item.Product.Image" alt="" style="width: 100px" />
                                        <div class="ms-3">
                                            <a href="" class="text-decoration-none">
                                                <h6 class="mb-0">@item.Product.ProductName</h6>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <form action="/Cart/DecreaseItem" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">-</button>
                                        </form>
                                        <span class="fw-semibold px-1">@item.Amount</span>
                                        <form action="/Cart/IncreaseItem" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">+</button>
                                        </form>
                                    </div>
                                </div>
                                <div class="col-2 text-center">
                                    <span class="fw-bold">@item.Product.Price ₺</span>
                                </div>
                                <div class="col-1">
                                    <form action="/Cart/RemoveItem" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="col-lg-5">
                <div class="my-3 card shadow-sm">
                    <div class="card-header bg-white">
                        <h2 class="h5 mb-0 fw-semibold">Sipariş Özeti</h2>
                    </div>
                    <div class="card-body p-0">
                        <table class="table mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-muted ps-3">Ara Toplam</td>
                                    <td class="text-end pe-3 fw-semibold">@Model.GetSubtotal().ToString("N2") ₺</td>
                                </tr>
                                <tr>
                                    <td class="text-muted ps-3">Kargo</td>
                                    <td class="text-end pe-3 text-success fw-semibold">Ücretsiz</td>
                                </tr>
                                <tr>
                                    <td class="text-muted ps-3">KDV (%20)</td>
                                    <td class="text-end pe-3 fw-semibold">@((Model.GetSubtotal() * 0.2).ToString("N2")) ₺</td>
                                </tr>
                                <tr class="table-light">
                                    <td class="ps-3 fw-bold fs-6">Toplam</td>
                                    <td class="text-end pe-3 fw-bold fs-6 text-primary">@Model.Sum().ToString("N2") ₺</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3">
                        <div class="d-grid">
                            <a asp-controller="Order" asp-action="CheckOut" class="btn btn-primary btn-lg">
                                Siparişi Tamamla
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }
       
    </div>
</section>